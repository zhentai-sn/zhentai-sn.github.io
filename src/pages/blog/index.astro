---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import TagList from '../../components/TagList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh">
	<head>
		<BaseHead title={`文章 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title"><span class="px-dot"></span>全部文章</h1>
			<p class="count">共 {posts.length} 篇</p>

			<ul class="grid">
				{
					posts.map((post) => (
						<li>
							<a class="card px-sm" href={`/blog/${post.id}/`}>
								<span class="date">
									<FormattedDate date={post.data.pubDate} />
								</span>
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
								<span class="read">读全文 →</span>
							</a>
							<TagList tags={post.data.tags} size="sm" />
						</li>
					))
				}
			</ul>
		</main>
		<Footer />

		<style>
			.page-title {
				display: flex;
				align-items: center;
				gap: 12px;
				font-size: 2.2rem;
			}
			.count {
				font-family: var(--font-silk);
				font-size: 0.7rem;
				color: var(--dim);
				margin: 0 0 2em;
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
				gap: 22px;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.grid > li {
				display: flex;
				flex-direction: column;
				gap: 10px;
			}
			.card {
				display: flex;
				flex-direction: column;
				background: var(--card);
				padding: 1.4em 1.5em;
				text-decoration: none;
				color: inherit;
				flex: 1;
				transition: transform 0.1s, box-shadow 0.1s;
			}
			.card:hover {
				transform: translate(2px, 2px);
				box-shadow: 1px 1px 0 var(--shadow);
			}
			.card .date {
				font-family: var(--font-silk);
				font-size: 0.6rem;
				color: var(--acc-d);
				letter-spacing: 1px;
			}
			.card h3 {
				font-size: 1.3rem;
				font-weight: 500;
				margin: 0.5em 0 0.4em;
			}
			.card:hover h3 { color: var(--pink); }
			.card p {
				font-size: 0.92rem;
				color: var(--dim);
				margin: 0 0 1em;
				flex: 1;
			}
			.card .read {
				font-family: var(--font-pixel);
				font-size: 0.9rem;
				color: var(--acc-d);
			}
			.card:hover .read { color: var(--pink); }
		</style>
	</body>
</html>
