---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { PROJECTS, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import avatarOwl from '../assets/avatar-owl.png';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="zh">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero px">
				<div class="hero-copy">
					<span class="badge">PLAYER 1 · ONLINE</span>
					<h1 class="lang-zh">嗨，我是<span class="g">真太</span><br />做医学 AI 的人</h1>
					<h1 class="lang-en">Hi, I'm <span class="g">Zhentai</span><br />I do medical AI</h1>
					<p class="lang-zh">
						在肾病理与深度学习之间来回横跳。这里记录我的研究笔记、开源项目，以及一些关于工具与心法的碎碎念。
					</p>
					<p class="lang-en">
						Bouncing between renal pathology and deep learning. Here I keep my research notes,
						open-source projects, and the occasional note on tools &amp; craft.
					</p>
					<div class="cta">
						<a class="primary px-sm" href="/blog"
							><span class="lang-zh">▶ 读文章</span><span class="lang-en">▶ Read posts</span></a
						>
						<a class="ghost px-sm" href="/about"
							><span class="lang-zh">关于我</span><span class="lang-en">About</span></a
						>
					</div>
				</div>
				<img
					class="hero-art"
					src={avatarOwl.src}
					alt="黑白吉卜力风格的可爱猫头鹰画像"
					width={768}
					height={960}
				/>
			</section>

			<h2 class="sec">
				<span class="px-dot"></span><span class="lang-zh">最新文章</span><span class="lang-en"
					>Latest posts</span
				>
			</h2>
			<ul class="grid">
				{
					posts.map((post) => (
						<li>
							<a class="card px-sm" href={`/blog/${post.id}/`}>
								<span class="date">
									<FormattedDate date={post.data.pubDate} />
								</span>
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
							</a>
						</li>
					))
				}
			</ul>

			<div class="more">
				<a class="px-sm" href="/blog"
					><span class="lang-zh">查看全部 →</span><span class="lang-en">View all →</span></a
				>
			</div>

			<h2 class="sec proj-sec">
				<span class="px-dot"></span><span class="lang-zh">项目</span><span class="lang-en"
					>Projects</span
				>
			</h2>
			<ul class="grid proj-grid">
				{
					PROJECTS.map((project) => (
						<li>
							<div class="card proj px-sm">
								<h3>{project.name}</h3>
								<p class="tagline">
									<span class="lang-zh">{project.tagline}</span>
									<span class="lang-en">{project.taglineEn}</span>
								</p>
								<p>
									<span class="lang-zh">{project.descZh}</span>
									<span class="lang-en">{project.descEn}</span>
								</p>
								<div class="links">
									<a class="primary px-sm" href={project.url} target="_blank" rel="noopener">
										<span class="lang-zh">▶ 打开</span>
										<span class="lang-en">▶ Launch</span>
									</a>
									<a class="ghost px-sm" href={project.post}>
										<span class="lang-zh">读一读</span>
										<span class="lang-en">Read up</span>
									</a>
									<a class="ghost px-sm" href={project.repo} target="_blank" rel="noopener">
										GitHub
									</a>
								</div>
							</div>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />

		<style>
			.hero {
				background: var(--card);
				padding: 2.4em 2.2em;
				margin-bottom: 3em;
				display: grid;
				grid-template-columns: 1fr auto;
				align-items: center;
				gap: 2em;
			}
			.hero-art {
				width: 280px;
				height: auto;
				border: none;
				mix-blend-mode: multiply;
			}
			.badge {
				display: inline-block;
				font-family: var(--font-silk);
				font-size: 0.65rem;
				background: var(--pink);
				color: #fff;
				padding: 4px 8px;
				border: 2px solid var(--shadow);
				margin-bottom: 1.1em;
				letter-spacing: 1px;
			}
			.hero h1 {
				font-size: 3rem;
				line-height: 1.05;
				margin-bottom: 0.5em;
			}
			.hero h1 .g { color: var(--acc-d); }
			.hero p {
				font-size: 1.1rem;
				color: var(--dim);
				max-width: 52ch;
				margin: 0;
			}
			.cta {
				margin-top: 1.6em;
				display: flex;
				gap: 12px;
				flex-wrap: wrap;
			}
			.cta a {
				font-family: var(--font-pixel);
				font-size: 1.05rem;
				text-decoration: none;
				padding: 8px 20px;
				transition: transform 0.1s, box-shadow 0.1s;
			}
			.cta .primary { background: var(--acc); color: #fff; }
			.cta .ghost { background: var(--card); color: var(--ink); }
			.cta a:hover {
				transform: translate(2px, 2px);
				box-shadow: 2px 2px 0 var(--shadow);
			}

			.sec {
				display: flex;
				align-items: center;
				gap: 12px;
				font-size: 1.6rem;
				margin-bottom: 1.1em;
			}

			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
				gap: 20px;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.card {
				display: block;
				background: var(--card);
				padding: 1.3em 1.4em;
				text-decoration: none;
				color: inherit;
				height: 100%;
				transition: transform 0.1s, box-shadow 0.1s;
			}
			.card:hover {
				transform: translate(2px, 2px);
				box-shadow: 1px 1px 0 var(--shadow);
			}
			.card .date {
				font-family: var(--font-silk);
				font-size: 0.6rem;
				color: var(--acc-d);
				letter-spacing: 1px;
			}
			.card h3 {
				font-size: 1.25rem;
				font-weight: 500;
				margin: 0.5em 0 0.4em;
			}
			.card:hover h3 { color: var(--pink); }
			.card p {
				font-size: 0.92rem;
				color: var(--dim);
				margin: 0;
			}

			.proj-sec { margin-top: 3em; }
			.proj-grid { grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); }
			.proj { cursor: default; }
			.proj:hover {
				transform: none;
				box-shadow: none;
			}
			.proj h3 { margin-top: 0; }
			.proj .tagline {
				font-family: var(--font-pixel);
				font-size: 1rem;
				color: var(--acc-d);
				margin: 0 0 0.6em;
			}
			.proj .links {
				display: flex;
				gap: 10px;
				flex-wrap: wrap;
				margin-top: 1.1em;
			}
			.proj .links a {
				font-family: var(--font-pixel);
				font-size: 0.95rem;
				text-decoration: none;
				padding: 5px 14px;
				transition: transform 0.1s, box-shadow 0.1s;
			}
			.proj .links .primary { background: var(--acc); color: #fff; }
			.proj .links .ghost { background: var(--bg); color: var(--ink); }
			.proj .links a:hover {
				transform: translate(2px, 2px);
				box-shadow: 2px 2px 0 var(--shadow);
			}

			.more { margin-top: 2.4em; }
			.more a {
				font-family: var(--font-pixel);
				display: inline-block;
				background: var(--card);
				color: var(--ink);
				padding: 6px 16px;
				text-decoration: none;
				transition: transform 0.1s, box-shadow 0.1s, background 0.1s;
			}
			.more a:hover {
				background: var(--acc);
				color: #fff;
				transform: translate(1px, 1px);
				box-shadow: 2px 2px 0 var(--shadow);
			}

			@media (max-width: 860px) {
				.hero {
					grid-template-columns: 1fr;
				}
				.hero-art {
					width: 220px;
					margin: 0 auto;
				}
			}

			@media (max-width: 520px) {
				.hero { padding: 1.8em 1.4em; }
				.hero h1 { font-size: 2.1rem; }
			}
		</style>
	</body>
</html>
