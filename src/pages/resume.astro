---
import { Font, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

// The ID photo is gitignored and only exists locally; render it when present.
const photoModules = import.meta.glob<{ default: ImageMetadata }>('../assets/resume-photo.*', {
	eager: true,
});
const resumePhoto = Object.values(photoModules)[0]?.default;
---

<!doctype html>
<html lang="zh">
	<head>
		<BaseHead
			title="简历 · Résumé"
			description="张桢泰 · 医学影像深度学习与医疗 AI 应用开发 / Zhentai Zhang — Medical imaging deep learning and healthcare AI application development"
		/>
		<Font cssVariable="--font-serif" />
	</head>
	<body>
		<Header />
		<main>
			{/* ---- toolbar (site UI, hidden when printing) ---- */}
			<div class="toolbar no-print">
				<span class="crumb">
					<span class="lang-zh">简历</span><span class="lang-en">Résumé</span>
				</span>
				<div class="print-tools">
					<span class="print-tip">
						<span class="lang-zh">打印时请在“更多设置”中关闭“页眉和页脚”</span>
						<span class="lang-en">Disable “Headers and footers” in More settings</span>
					</span>
					<button id="print-resume" class="dl" type="button">
						<span class="lang-zh">⬇ 下载 / 打印 PDF</span><span class="lang-en">⬇ Download / Print PDF</span>
					</button>
				</div>
			</div>

			<article class="cv">
				{/* ===================== Header ===================== */}
				<header class="cv-head">
					<div class="head-main">
						<h1 class="name">
							<span class="lang-zh">张桢泰</span><span class="lang-en">ZHENTAI ZHANG</span>
						</h1>
						<p class="meta-line objective">
							<span class="lang-zh">求职意向：AI Agent 算法工程师</span>
							<span class="lang-en">Target Role: AI Agent Algorithm Engineer</span>
							<span class="sep">|</span>
							<span class="lang-zh">求职地：深圳</span>
							<span class="lang-en">Location: Shenzhen</span>
						</p>
						<p class="meta-line contacts">
							<span class="contact-item">
								<span class="lang-zh">电话：</span><span class="lang-en">Phone: </span>
								<button class="contact-reveal" type="button" data-contact="phone">
									<span class="lang-zh">点击查看</span><span class="lang-en">reveal</span>
								</button>
							</span>
							<span class="sep">|</span>
							<span class="contact-item">
								<span class="lang-zh">邮箱：</span><span class="lang-en">Email: </span>
								<button class="contact-reveal" type="button" data-contact="email">
									<span class="lang-zh">点击查看</span><span class="lang-en">reveal</span>
								</button>
							</span>
							<span class="sep">|</span>
							<span class="contact-item">
								<span class="lang-zh">博客：</span><span class="lang-en">Blog: </span>
								<a class="contact-value" href="https://zhentai-sn.github.io/" target="_blank" rel="noopener"
									>zhentai-sn.github.io</a
								>
							</span>
						</p>
					</div>
					{resumePhoto && (
						<Image class="photo" src={resumePhoto} alt="张桢泰证件照" width={300} loading="eager" />
					)}
				</header>

				{/* ===================== Education ===================== */}
				<section class="cv-sec">
					<h2 class="sec-title">
						<span class="lang-zh">教育背景</span><span class="lang-en">Education</span>
					</h2>

					<div class="item">
						<div class="row">
							<div class="row-main">
								<strong><span class="lang-zh">南方医科大学</span><span class="lang-en">Southern Medical University</span></strong>,
								<span class="lang-zh">电子信息, 硕士</span>
								<span class="lang-en">Electronic Information, Master's Degree</span>
							</div>
							<div class="row-date">2022.09 - 2025.06</div>
						</div>
						<div class="edu-details">
							<span class="edu-courses lang-zh">主要课程：机器学习、算法设计与分析、数理统计与随机过程、数值分析</span>
							<span class="edu-courses lang-en">Coursework: Machine Learning, Algorithm Design, Statistics &amp; Stochastic Processes, Numerical Analysis</span>
							<span class="edu-gpa">GPA 3.4/4</span>
						</div>
					</div>

					<div class="item">
						<div class="row">
							<div class="row-main">
								<strong><span class="lang-zh">南方医科大学</span><span class="lang-en">Southern Medical University</span></strong>,
								<span class="lang-zh">生物医学工程, 学士</span>
								<span class="lang-en">Biomedical Engineering, Bachelor's Degree</span>
							</div>
							<div class="row-date">2018.09 - 2022.07</div>
						</div>
						<div class="edu-details">
							<span class="edu-courses lang-zh">主要课程：数字图像处理、模式识别、CT 和 MR 成像原理与技术</span>
							<span class="edu-courses lang-en">Coursework: Digital Image Processing, Pattern Recognition, CT/MR Imaging</span>
							<span class="edu-gpa">GPA 3.7/5</span>
						</div>
					</div>
				</section>

				{/* ===================== Work Experience ===================== */}
				<section class="cv-sec">
					<h2 class="sec-title">
						<span class="lang-zh">工作经历</span><span class="lang-en">Work Experience</span>
					</h2>

					<div class="item">
						<div class="row">
							<div class="row-main">
								<strong>广东行稳数智科技有限公司</strong>,
								<span class="lang-zh">AI Agent 算法工程师</span>
								<span class="lang-en">AI Agent Algorithm Engineer</span>
							</div>
							<div class="row-date">2025.06 - <span class="lang-zh">至今</span><span class="lang-en">Present</span></div>
						</div>
						<ul class="bullets">
							<li>
								<span class="lang-zh">构建<strong>多智能体系统</strong>，通过共享记忆状态机、工具与上下文隔离、事件驱动调度，解决单 Agent 上下文过载、复杂意图场景中的工具误用、跨场景复用差的问题。相关能力支撑区域健康管理平台，覆盖百万级用户，落地智能客服、健康方案管理、大规模队列用户健康风险分析等应用。</span>
								<span class="lang-en">Built a <strong>multi-agent system</strong> with a shared-memory state machine, isolated tools and contexts, and event-driven scheduling, addressing single-agent context overload, tool misuse under complex intents, and poor cross-scenario reuse. It powers a regional health-management platform serving millions of users, with applications in intelligent customer service, health-plan management, and large-cohort health-risk analysis.</span>
							</li>
							<li>
								<span class="lang-zh">参与 <strong>AI 原生数据湖仓</strong>的整体建设，负责基于 RAGFlow 和 pgvector 构建 Agent 外部持久上下文与语义检索模块。统一接入多源异构的用户数据，解决多源数据查询割裂，以及垂类领域知识与个人专属信息召回难的问题，专家盲测中生成内容质量显著优于通用模型。</span>
								<span class="lang-en">Contributed to an <strong>AI-native data lakehouse</strong>, owning the agents' persistent external context and semantic-retrieval module built on RAGFlow and pgvector. Unified multi-source heterogeneous user data to fix fragmented queries and poor recall of domain knowledge and personal information; in expert blind tests, generated content clearly outperformed general-purpose models.</span>
							</li>
							<li>
								<span class="lang-zh">负责<strong>全双工实时语音交互 Agent</strong> 的研发，用于外呼回访信息采集，针对端到端语音模型工具调用能力弱的问题，构建“语音主链路 + 外部辅助模型支路”的双重 harness 链路，兼顾对话流畅性与信息检测、槽位回收、上下文补全的实时性与准确性，上线后累计服务 5 万+ 人次。</span>
								<span class="lang-en">Owned a <strong>full-duplex real-time voice agent</strong> for outbound follow-up data collection. To offset weak tool calling in end-to-end speech models, built a dual harness of a main voice path plus an auxiliary-model side path, keeping conversations fluent while making information detection, slot filling, and context completion timely and accurate; it has served 50,000+ interactions since launch.</span>
							</li>
							<li>
								<span class="lang-zh">负责建设并维护 <strong>AI 基础设施</strong>，打通 LiteLLM 模型网关、vLLM/Xinference 推理服务、Langfuse LLM 链路观测、Prometheus/Grafana 监控告警全链路，提升异常排查与响应效率。</span>
								<span class="lang-en">Built and maintained <strong>AI infrastructure end to end</strong> — LiteLLM model gateway, vLLM/Xinference inference, Langfuse LLM tracing, and Prometheus/Grafana monitoring and alerting — speeding up incident diagnosis and response.</span>
							</li>
							<li>
								<span class="lang-zh">优化 <strong>AI 全栈应用开发流程</strong>，针对垂直需求实现全栈交付（前端/后端/算法/部署），降低多人联调成本；沉淀共享开发流程与 Skills 规范，统一开发环境上下文，提升团队与 Agent 的协作效率。</span>
								<span class="lang-en">Streamlined <strong>AI full-stack development</strong> by delivering vertical features end to end (frontend, backend, algorithms, deployment), cutting cross-team integration overhead; codified shared workflows and Skills conventions to unify development context and improve collaboration between the team and agents.</span>
							</li>
						</ul>
					</div>

					<div class="item">
						<div class="row">
							<div class="row-main">
								<strong><span class="lang-zh">科大讯飞华南人工智能研究院</span><span class="lang-en">iFLYTEK South China AI Research Institute</span></strong>,
								<span class="lang-zh">助理算法工程师（实习）</span>
								<span class="lang-en">Assistant Algorithm Engineer (Intern)</span>
							</div>
							<div class="row-date">2024.11 - 2025.02</div>
						</div>
						<ul class="bullets">
							<li>
								<span class="lang-zh">参与搭建胸片病灶检测<strong>数据标注-清洗-质检流水线</strong>，负责生成带解剖方位信息的病灶描述文本 pipeline 模块，支撑胸片图文大模型训练。</span>
								<span class="lang-en">Helped build a chest X-ray lesion-detection <strong>annotation-cleaning-QA pipeline</strong>, owning the module that generates lesion descriptions with anatomical location to support training of the chest X-ray vision-language model.</span>
							</li>
							<li>
								<span class="lang-zh">针对文本提示驱动的病灶定位问题，基于 Grounding-DINO 训练<strong>视觉-文本锚定检测模型</strong>，平均 F1 较 YOLOv10 基线提升 5.6 个百分点。</span>
								<span class="lang-en">For text-prompted lesion localization, trained a <strong>visual-text grounding detector</strong> based on Grounding-DINO, improving mean F1 by 5.6 points over a YOLOv10 baseline.</span>
							</li>
							<li>
								<span class="lang-zh">参与<strong>胸片图文大模型</strong>评估与上线，负责诊断文本标注评估工具构建；分析 3.6 万条线上回流数据，发现反馈下降与肺炎类病种占比上升相关，为模型迭代与数据配比优化提供依据。</span>
								<span class="lang-en">Took part in evaluating and launching a <strong>chest X-ray vision-language model</strong> and built the diagnostic-text annotation and evaluation tool; analyzed 36,000+ production feedback records and linked a feedback drop to a rising share of pneumonia-type cases, informing model iteration and data-mix optimization.</span>
							</li>
						</ul>
					</div>
				</section>

				{/* ===================== Research ===================== */}
				<section class="cv-sec">
					<h2 class="sec-title">
						<span class="lang-zh">项目经历</span><span class="lang-en">Projects</span>
					</h2>

					<div class="item">
						<div class="row">
							<div class="row-main">
								<strong><span class="lang-zh">肾脏电镜图像自监督分割与超微特征量化（国自然项目）</span><span class="lang-en">Self-Supervised Segmentation and Ultrastructure Quantification of Renal TEM Images (NSFC Project)</span></strong>
								<span class="sep">|</span>
								<span class="lang-zh">硕士科研项目</span>
								<span class="lang-en">Master's Research Project</span>
							</div>
							<div class="row-date">2022.09 - 2025.06</div>
						</div>
						<ul class="bullets">
							<li>
								<span class="lang-zh">针对电镜图像标注稀缺、全局上下文与局部细节难以兼顾的问题，提出 <strong>GCLR 自监督预训练任务</strong>（全局聚类 + 局部恢复）与 USRegCon 语义自适应区域划分对比学习，在有限标注下提升肾小球滤过屏障分割性能，平均 Dice 较随机初始化提升 4.57%，较 SOTA 自监督方法提升 1.03%。</span>
								<span class="lang-en">To tackle scarce labels and the difficulty of capturing both global context and local detail in TEM images, proposed the <strong>GCLR self-supervised pretext task</strong> (global clustering + local restoration) and USRegCon semantic-adaptive region contrastive learning, improving glomerular filtration barrier segmentation with limited labels: mean Dice rose by 4.57 points over random initialization and 1.03 points over the SOTA self-supervised method.</span>
							</li>
							<li>
								<span class="lang-zh">搭建分割、检测、分类及图文多模态模型的训练、评估与迭代 pipeline（U-Net、SAM、Faster R-CNN、DINO、Qwen-VL、InternVL 等），并结合图像处理算法构建<strong>肾脏超微特征自动量化框架 Glo-MMF</strong>。</span>
								<span class="lang-en">Built training, evaluation, and iteration pipelines for segmentation, detection, classification, and vision-language models (U-Net, SAM, Faster R-CNN, DINO, Qwen-VL, InternVL, etc.), and combined them with image-processing algorithms into the <strong>automated renal ultrastructure quantification framework, Glo-MMF</strong>.</span>
							</li>
						</ul>
					</div>
				</section>

				{/* ===================== Publications ===================== */}
				<section class="cv-sec">
					<h2 class="sec-title">
						<span class="lang-zh">发表论文</span><span class="lang-en">Publications</span>
					</h2>
					<ol class="pubs">
						<li>
							<span class="me">Zhang Z.</span>, Weng D., Zhang G., et al.
							<a href="https://doi.org/10.1016/j.cmpb.2026.109431" target="_blank" rel="noopener">
								Glo-MMF: A modular multi-model framework for automated morphometry of glomerular ultrastructural features</a>.
							<em>Comput. Methods Programs Biomed.</em>, 283:109431, 2026.
							<span class="pub-metric">
								(<span class="lang-zh">二区，IF：6.4</span><span class="lang-en">Q2, IF: 6.4</span>)
							</span>
						</li>
						<li>
							Lin G., <span class="me">Zhang Z.</span>, Long K., et al.
							<a href="https://doi.org/10.1016/j.artmed.2023.102720" target="_blank" rel="noopener">
								GCLR: A self-supervised representation learning pretext task for glomerular filtration barrier segmentation in TEM images</a>.
							<em>Artif. Intell. Med.</em>, 146:102720, 2023.
							<span class="pub-metric">
								(<span class="lang-zh">一区，IF：7.8</span><span class="lang-en">Q1, IF: 7.8</span>)
							</span>
						</li>
						<li>
							Lin G., <span class="me">Zhang Z.</span>, Lu Y., et al.
							<a href="https://doi.org/10.12122/j.issn.1673-4254.2023.05.18" target="_blank" rel="noopener">
								<span class="lang-zh">肾小球超微结构分割算法：基于区域级对比学习的深度模型</span><span class="lang-en">A region-level contrastive learning-based deep model for glomerular ultrastructure segmentation</span></a>.
							<em>J. South. Med. Univ.</em>, 43(5):815-824, 2023.
							<span class="pub-metric">
								(<span class="lang-zh">中文核心</span><span class="lang-en">Chinese Core Journal</span>)
							</span>
						</li>
					</ol>
				</section>

				{/* ===================== Skills ===================== */}
				<section class="cv-sec">
					<h2 class="sec-title">
						<span class="lang-zh">技术能力</span><span class="lang-en">Technical Skills</span>
					</h2>
					<ul class="skills">
						<li>
							<span class="lang-zh">Agent 与 RAG：</span><span class="lang-en">Agents &amp; RAG: </span><span class="lang-zh">多智能体、语音 Agent、LangChain、Agno、RAGFlow、pgvector</span>
							<span class="lang-en">Multi-agent, voice agents, LangChain, Agno, RAGFlow, pgvector</span>
						</li>
						<li>
							<span class="lang-zh">模型训练：</span><span class="lang-en">Model training: </span><span class="lang-zh">PyTorch、SFT、LoRA、自监督预训练、SAM、DINO、YOLO、Qwen-VL</span>
							<span class="lang-en">PyTorch, SFT, LoRA, self-supervised learning, SAM, DINO, YOLO</span>
						</li>
						<li>
							<span class="lang-zh">工程化：</span><span class="lang-en">Engineering: </span><span class="lang-zh">Python、FastAPI、Docker、K8s、vLLM、LiteLLM、Langfuse、Prometheus</span>
							<span class="lang-en">Python, FastAPI, Docker, K8s, vLLM, LiteLLM, Langfuse</span>
						</li>
					</ul>
				</section>
			</article>
		</main>
		<Footer showEmail={false} />

		<style>
			/* The résumé sheet uses its own restrained black-on-white palette,
			   independent of the site's GameBoy theme, so it reads as a formal
			   academic document both on screen and when exported to PDF. */
			.cv {
				--paper: #ffffff;
				--doc-ink: #1a1a1a;
				--doc-sub: #333333;
				--doc-rule: #1a1a1a;
				--doc-hair: #cfcfcf;
			}

			main { width: 820px; }

			/* ---------- toolbar ---------- */
			.toolbar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 12px;
				margin-bottom: 1.2em;
				flex-wrap: wrap;
			}
			.crumb {
				font-family: var(--font-silk);
				font-size: 0.7rem;
				letter-spacing: 1px;
				color: var(--dim);
				text-transform: uppercase;
			}
			.dl {
				font-family: var(--font-pixel);
				font-size: 1rem;
				background: var(--acc);
				color: #fff;
				border: 3px solid var(--shadow);
				box-shadow: 3px 3px 0 var(--shadow);
				cursor: pointer;
				padding: 7px 16px;
				line-height: 1;
				transition: transform 0.1s, box-shadow 0.1s;
			}
			.dl:hover { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--shadow); }
			.print-tools {
				display: flex;
				align-items: center;
				justify-content: flex-end;
				gap: 10px;
				flex-wrap: wrap;
			}
			.print-tip {
				max-width: 280px;
				font-size: 0.78rem;
				line-height: 1.25;
				color: var(--dim);
				text-align: right;
			}

			/* ---------- the document ---------- */
			.cv {
				background: var(--paper);
				color: var(--doc-ink);
				font-family: var(--font-serif);
				font-size: 15.5px;
				line-height: 1.5;
				padding: 3.2em 3.4em;
				box-shadow: 0 10px 40px rgba(0, 0, 0, 0.18);
			}

			/* ---------- header ---------- */
			/* Compact header: name + two info lines on the left, ID photo on the right. */
			.cv-head {
				display: flex;
				/* Bottom-align so the photo's lower edge lines up with the contact line. */
				align-items: flex-end;
				justify-content: space-between;
				gap: 1.5em;
				text-align: left;
				margin-bottom: 1em;
			}
			.head-main {
				flex: 1;
				min-width: 0;
				display: flex;
				flex-direction: column;
				gap: 0.35em;
			}
			/* ID photo: crop the square source to a 3:4 portrait around the face. */
			.photo {
				flex-shrink: 0;
				width: 6em;
				height: auto;
				aspect-ratio: 3 / 4;
				object-fit: cover;
				object-position: 50% 30%;
				border: none;
				box-shadow: none;
				display: block;
			}
			.name {
				font-family: var(--font-serif);
				font-weight: 700;
				font-size: 2.1rem;
				letter-spacing: 4px;
				line-height: 1.15;
				color: var(--doc-ink);
				margin: 0 0 0.1em;
			}
			.meta-line {
				margin: 0;
				font-size: 0.95rem;
				color: var(--doc-ink);
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				column-gap: 0.55em;
				row-gap: 0.2em;
			}
			.objective { font-weight: 700; }
			/* Keep phone | email | blog on one line even after the values are revealed. */
			.contacts { flex-wrap: nowrap; white-space: nowrap; }
			.sep { color: #999; font-weight: 400; }
			.contact-item {
				display: inline-flex;
				align-items: center;
				white-space: nowrap;
			}
			.contact-reveal {
				font: inherit;
				color: var(--doc-ink);
				background: #f4f4f4;
				border: 1px dashed #999;
				border-radius: 2px;
				padding: 0.12em 0.45em;
				cursor: pointer;
			}
			.contact-reveal:hover,
			.contact-reveal:focus-visible {
				background: #e8e8e8;
				border-color: var(--doc-ink);
			}
			.contact-value { border-bottom: 1px dotted #999; }

			/* ---------- section ---------- */
			.cv-sec { margin-bottom: 1.3em; }
			.cv-sec:last-child { margin-bottom: 0; }
			.sec-title {
				font-family: var(--font-serif);
				font-weight: 700;
				font-size: 1.28rem;
				color: var(--doc-ink);
				margin: 0 0 0.55em;
				padding-bottom: 0.15em;
				border-bottom: 1.5px solid var(--doc-rule);
			}

			/* ---------- item rows ---------- */
			.item { margin-bottom: 0.75em; }
			.item:last-child { margin-bottom: 0; }
			.row {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1.2em;
			}
			.row-main { flex: 1; }
			.row-main strong { font-weight: 700; }
			.row-date {
				white-space: nowrap;
				flex-shrink: 0;
				color: var(--doc-ink);
			}
			.edu-details {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1em;
				margin-top: 0.1em;
				font-size: 0.92em;
				color: var(--doc-sub);
			}
			.edu-courses {
				min-width: 0;
				white-space: nowrap;
			}
			.edu-gpa {
				flex-shrink: 0;
				white-space: nowrap;
				color: var(--doc-ink);
			}

			.bullets {
				margin: 0.15em 0 0;
				padding-left: 1.25em;
				list-style: none;
			}
			.bullets li {
				position: relative;
				margin-bottom: 0.15em;
			}
			.bullets li::before {
				content: "•";
				position: absolute;
				left: -1.05em;
			}

			.skills { margin: 0; padding-left: 1.25em; }
			.skills li { margin-bottom: 0.2em; }

			.pubs {
				margin: 0;
				padding-left: 1.35em;
				font-size: 0.9em;
				line-height: 1.35;
			}
			.pubs li { margin-bottom: 0.28em; }
			.pubs a {
				color: var(--doc-ink);
				text-decoration: underline;
				text-decoration-color: #888;
				text-decoration-thickness: 1px;
				text-underline-offset: 2px;
			}
			.pubs a:hover { text-decoration-color: var(--doc-ink); }
			.pub-metric {
				color: var(--doc-sub);
				font-weight: 400;
				white-space: nowrap;
			}
			.me { font-weight: 700; }

			@media (max-width: 560px) {
				.cv { padding: 2em 1.5em; }
				.name { font-size: 1.8rem; letter-spacing: 2px; }
				.photo { width: 4.8em; }
				.cv-head { gap: 0.9em; }
				.meta-line .sep { display: none; }
				.meta-line,
				.contacts { flex-direction: column; align-items: flex-start; }
				.row { flex-direction: column; gap: 0; }
				.edu-details {
					align-items: flex-start;
					flex-direction: column;
					gap: 0;
				}
				.edu-courses { white-space: normal; }
			}

			/* ---------- print / PDF export ---------- */
			@media print {
				/* The site header is position:sticky; when printing, Chrome can stamp
				   a composited ghost of its pixel logo onto the page at the current
				   scroll offset. display:none doesn't reliably tear that layer down,
				   so drop the sticky positioning and collapse the header to nothing.
				   Scope to the top-level site header only — `.cv-head` is also a
				   <header> and must keep printing. */
				:global(body > header) {
					position: static !important;
					visibility: hidden !important;
					height: 0 !important;
					padding: 0 !important;
					border: 0 !important;
					overflow: hidden !important;
				}
				:global(footer),
				.no-print { display: none !important; }
				:global(body) {
					background: #fff !important;
					background-image: none !important;
				}
				main { width: 100%; max-width: 100%; padding: 0; margin: 0; }
				.cv {
					background: #fff;
					box-shadow: none;
					padding: 0;
					font-size: 9.8pt;
					line-height: 1.33;
				}
				.cv-head { margin-bottom: 0.6em; }
				.head-main { gap: 0.2em; }
				.name { font-size: 1.9rem; }
				.photo { width: 5.4em; }
				.meta-line a { text-decoration: none; border: 0; }
				.contact-reveal {
					background: none;
					border: 0;
					padding: 0;
				}
				.cv-sec { margin-bottom: 0.62em; }
				.sec-title {
					font-size: 1.15rem;
					margin-bottom: 0.28em;
					padding-bottom: 0.08em;
				}
				.item { margin-bottom: 0.38em; }
				.bullets { margin-top: 0.08em; }
				.bullets li,
				.skills li { margin-bottom: 0.06em; }
				.pubs {
					font-size: 0.86em;
					line-height: 1.24;
				}
				.pubs li { margin-bottom: 0.12em; }
				:global(html[data-lang='zh']) .cv {
					font-size: 10.3pt;
					line-height: 1.35;
				}
				:global(html[data-lang='zh']) .cv-sec { margin-bottom: 0.6em; }
				:global(html[data-lang='zh']) .sec-title { margin-bottom: 0.34em; }
				:global(html[data-lang='zh']) .item { margin-bottom: 0.4em; }
				:global(html[data-lang='zh']) .bullets li,
				:global(html[data-lang='zh']) .skills li { margin-bottom: 0.1em; }
				:global(html[data-lang='zh']) .pubs {
					font-size: 0.9em;
					line-height: 1.28;
				}
				.cv-sec { break-inside: avoid; }
				.item, .pubs li { break-inside: avoid; }
			}
		</style>

		<style is:global>
			@page {
				size: A4;
				margin: 9mm 12mm;
			}
		</style>

		<script is:inline>
			document.addEventListener('click', (e) => {
				if (!(e.target instanceof Element)) return;

				const revealButton = e.target.closest('.contact-reveal');
				if (revealButton) {
					const encodedContacts = {
						email: [122, 104, 101, 110, 116, 97, 105, 46, 115, 110, 64, 113, 113, 46, 99, 111, 109],
						phone: [49, 51, 50, 50, 54, 55, 49, 51, 55, 48, 52],
					};
					const type = revealButton.dataset.contact;
					const codes = encodedContacts[type];
					if (!codes) return;

					const value = String.fromCharCode(...codes);
					const link = document.createElement('a');
					link.className = 'contact-value';
					link.href = type === 'email' ? `mailto:${value}` : `tel:+86${value}`;
					link.textContent = value;
					revealButton.replaceWith(link);
					return;
				}

				if (e.target.closest('#print-resume')) window.print();
			});
		</script>
	</body>
</html>
