---
// Giscus comments — backed by GitHub Discussions (no database).
// Reactions are enabled, which double as "likes" on the post.
---

<section class="comments">
	<h2 class="comments-title"><span class="px-dot"></span>评论 &amp; 点赞</h2>
	<div class="giscus"></div>
</section>

<script
	src="https://giscus.app/client.js"
	data-repo="zhentai-sn/zhentai-sn.github.io"
	data-repo-id="R_kgDOStwFyg"
	data-category="Announcements"
	data-category-id="DIC_kwDOStwFys4C-RIm"
	data-mapping="pathname"
	data-strict="0"
	data-reactions-enabled="1"
	data-emit-metadata="0"
	data-input-position="top"
	data-theme="light"
	data-lang="zh-CN"
	data-loading="lazy"
	crossorigin="anonymous"
	async></script>

<script is:inline>
	(function () {
		function currentTheme() {
			return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
		}
		function pushTheme(theme) {
			const f = document.querySelector('iframe.giscus-frame');
			if (f && f.contentWindow) {
				f.contentWindow.postMessage(
					{ giscus: { setConfig: { theme } } },
					'https://giscus.app',
				);
			}
		}
		// When the giscus iframe signals ready, sync it to our current theme.
		window.addEventListener('message', (e) => {
			if (e.origin !== 'https://giscus.app') return;
			if (!(e.data && e.data.giscus)) return;
			pushTheme(currentTheme());
		});
		// Let the header theme toggle update giscus too.
		window.__setGiscusTheme = () => pushTheme(currentTheme());
	})();
</script>

<style>
	.comments {
		margin-top: 3em;
		padding-top: 2em;
		border-top: 3px dashed var(--acc);
	}
	.comments-title {
		display: flex;
		align-items: center;
		gap: 12px;
		font-size: 1.5rem;
		margin-bottom: 1.2em;
	}
</style>
