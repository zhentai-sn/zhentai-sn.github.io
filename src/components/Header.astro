---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="logo" href="/">
			<span class="sprite" aria-hidden="true"></span>
			<b>{SITE_TITLE}</b>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">home</HeaderLink>
			<HeaderLink href="/blog">posts</HeaderLink>
			<HeaderLink href="/about">about</HeaderLink>
		</div>
		<button id="theme-toggle" class="px-sm" aria-label="切换深浅色">
			<span class="theme-icon">◐</span>
		</button>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0.9em 1.2em;
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--bg);
		border-bottom: 3px solid var(--shadow);
	}
	nav {
		max-width: 880px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}
	.logo {
		display: flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
		color: var(--ink);
	}
	.logo b {
		font-family: var(--font-pixel);
		font-size: 1.3rem;
		letter-spacing: 0.5px;
	}
	.sprite {
		width: 34px;
		height: 34px;
		background-color: var(--acc);
		border: 3px solid var(--shadow);
		image-rendering: pixelated;
		/* two pixel eyes */
		background-image:
			radial-gradient(circle at 33% 40%, var(--shadow) 16%, transparent 17%),
			radial-gradient(circle at 67% 40%, var(--shadow) 16%, transparent 17%);
		flex-shrink: 0;
	}
	.internal-links {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
	}
	#theme-toggle {
		font-family: var(--font-pixel);
		font-size: 1.1rem;
		background: var(--card);
		color: var(--ink);
		cursor: pointer;
		padding: 4px 10px;
		line-height: 1;
		transition: transform 0.1s, box-shadow 0.1s;
	}
	#theme-toggle:hover {
		transform: translate(1px, 1px);
		box-shadow: 1px 1px 0 var(--shadow);
		background: var(--acc);
		color: #fff;
	}
	@media (max-width: 520px) {
		.logo b { font-size: 1rem; }
		.internal-links { gap: 4px; }
	}
</style>

<script is:inline>
	// Theme is initialised in <head> (BaseHead) to avoid a flash.
	document.addEventListener('click', (e) => {
		const btn = e.target.closest('#theme-toggle');
		if (!btn) return;
		const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		localStorage.setItem('theme', next);
		// Keep the giscus comment widget's theme in sync, if present.
		if (window.__setGiscusTheme) window.__setGiscusTheme();
	});
</script>
