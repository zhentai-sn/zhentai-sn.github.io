---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import Search from './Search.astro';
---

<header>
	<nav>
		<a class="logo" href="/">
			<span class="sprite" aria-hidden="true"></span>
			<b>{SITE_TITLE}</b>
		</a>
		<div class="internal-links">
			<HeaderLink href="/"
				><span class="lang-zh">首页</span><span class="lang-en">home</span></HeaderLink
			>
			<HeaderLink href="/blog"
				><span class="lang-zh">文章</span><span class="lang-en">posts</span></HeaderLink
			>
			<HeaderLink href="/tags"
				><span class="lang-zh">标签</span><span class="lang-en">tags</span></HeaderLink
			>
			<HeaderLink href="/resume"
				><span class="lang-zh">简历</span><span class="lang-en">resume</span></HeaderLink
			>
			<HeaderLink href="/about"
				><span class="lang-zh">关于</span><span class="lang-en">about</span></HeaderLink
			>
		</div>
		<div class="controls">
			<Search />
			<button id="lang-toggle" class="px-sm" aria-label="切换语言 / switch language">
				<span class="lang-zh">中</span><span class="lang-en">EN</span>
			</button>
			<button id="theme-toggle" class="px-sm" aria-label="切换深浅色">
				<span class="theme-icon">◐</span>
			</button>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0.9em 1.2em;
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--bg);
		border-bottom: 3px solid var(--shadow);
	}
	nav {
		max-width: 880px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		flex-wrap: wrap;
	}
	.logo {
		display: flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
		color: var(--ink);
	}
	.logo b {
		font-family: var(--font-pixel);
		font-size: 1.3rem;
		letter-spacing: 0.5px;
	}
	.sprite {
		width: 34px;
		height: 34px;
		background-color: var(--acc);
		border: 3px solid var(--shadow);
		image-rendering: pixelated;
		background-image:
			radial-gradient(circle at 33% 40%, var(--shadow) 16%, transparent 17%),
			radial-gradient(circle at 67% 40%, var(--shadow) 16%, transparent 17%);
		flex-shrink: 0;
	}
	.internal-links { display: flex; gap: 8px; flex-wrap: wrap; }
	.controls { display: flex; gap: 8px; align-items: center; }

	#theme-toggle,
	#lang-toggle {
		font-family: var(--font-pixel);
		font-size: 1.05rem;
		background: var(--card);
		color: var(--ink);
		cursor: pointer;
		padding: 4px 10px;
		line-height: 1;
		transition: transform 0.1s, box-shadow 0.1s, background 0.1s;
	}
	#theme-toggle:hover,
	#lang-toggle:hover {
		transform: translate(1px, 1px);
		box-shadow: 1px 1px 0 var(--shadow);
		background: var(--acc);
		color: #fff;
	}

	@media (max-width: 600px) {
		.logo b { font-size: 1rem; }
		.internal-links { gap: 4px; font-size: 0.9rem; }
		nav { gap: 8px; }
	}
</style>

<script is:inline>
	// Theme + language toggles. Initial values are set in <head> (BaseHead) to avoid flashes.
	document.addEventListener('click', (e) => {
		const themeBtn = e.target.closest('#theme-toggle');
		if (themeBtn) {
			const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
			document.documentElement.dataset.theme = next;
			localStorage.setItem('theme', next);
			if (window.__setGiscusTheme) window.__setGiscusTheme();
			return;
		}
		const langBtn = e.target.closest('#lang-toggle');
		if (langBtn) {
			const next = document.documentElement.dataset.lang === 'en' ? 'zh' : 'en';
			document.documentElement.dataset.lang = next;
			localStorage.setItem('lang', next);
			if (window.__setGiscusLang) window.__setGiscusLang();
		}
	});
</script>
