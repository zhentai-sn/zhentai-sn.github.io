---
interface Props {
	tags: string[];
	size?: 'sm' | 'md';
}
const { tags, size = 'md' } = Astro.props;
---

{
	tags && tags.length > 0 && (
		<ul class:list={['taglist', size]}>
			{tags.map((tag) => (
				<li>
					<a href={`/tags/${encodeURIComponent(tag)}/`} class="tag px-sm"># {tag}</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.taglist {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.tag {
		display: inline-block;
		font-family: var(--font-silk);
		text-decoration: none;
		background: var(--bg);
		color: var(--ink);
		padding: 3px 8px;
		transition: transform 0.1s, box-shadow 0.1s, background 0.1s;
	}
	.tag:hover {
		background: var(--acc);
		color: #fff;
		transform: translate(1px, 1px);
		box-shadow: 1px 1px 0 var(--shadow);
	}
	.sm .tag {
		font-size: 0.55rem;
		padding: 2px 6px;
	}
	.md .tag {
		font-size: 0.65rem;
	}
</style>
