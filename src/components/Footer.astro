---
import { GITHUB_URL, EMAIL } from '../consts';
const today = new Date();
---

<footer>
	<div class="inner">
		<span>made with <span class="heart">&hearts;</span> &amp; pixels &middot; &copy; {today.getFullYear()} 真太</span>
		<div class="links">
			<a href={GITHUB_URL} target="_blank" rel="noopener">github</a>
			<a href={`mailto:${EMAIL}`}>email</a>
			<a href="/rss.xml">rss</a>
		</div>
	</div>
</footer>

<style>
	footer {
		border-top: 3px solid var(--shadow);
		background: var(--bg);
		color: var(--dim);
		font-family: var(--font-pixel);
		font-size: 0.95rem;
	}
	.inner {
		max-width: 880px;
		margin: 0 auto;
		padding: 1.5em 1.2em;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px;
		flex-wrap: wrap;
	}
	.heart { color: var(--pink); }
	.links { display: flex; gap: 16px; }
	.links a { color: var(--acc-d); text-decoration: none; }
	.links a:hover { color: var(--pink); }
</style>
