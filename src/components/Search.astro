---
// Client-side fuzzy search over /search.json using Fuse.js. No backend.
---

<button id="search-open" class="px-sm" aria-label="搜索文章">
	<span aria-hidden="true">⌕</span>
</button>

<div id="search-modal" class="search-modal" hidden>
	<div class="search-backdrop" data-close></div>
	<div class="search-box px" role="dialog" aria-modal="true" aria-label="站内搜索">
		<div class="search-head">
			<span class="prompt">搜索</span>
			<input
				id="search-input"
				type="text"
				placeholder="输入关键词…（标题 / 摘要 / 标签 / 正文）"
				autocomplete="off"
				spellcheck="false"
			/>
			<button class="search-close px-sm" data-close aria-label="关闭">ESC</button>
		</div>
		<ul id="search-results" class="search-results"></ul>
		<p id="search-empty" class="search-empty" hidden>没有找到匹配的文章。</p>
		<p class="search-hint">按 <kbd>/</kbd> 打开 · <kbd>↑</kbd><kbd>↓</kbd> 选择 · <kbd>Enter</kbd> 打开 · <kbd>Esc</kbd> 关闭</p>
	</div>
</div>

<style>
	#search-open {
		font-family: var(--font-pixel);
		font-size: 1.2rem;
		line-height: 1;
		background: var(--card);
		color: var(--ink);
		cursor: pointer;
		padding: 3px 11px;
		transition: transform 0.1s, box-shadow 0.1s, background 0.1s;
	}
	#search-open:hover {
		transform: translate(1px, 1px);
		box-shadow: 1px 1px 0 var(--shadow);
		background: var(--acc);
		color: #fff;
	}

	.search-modal {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		align-items: flex-start;
		justify-content: center;
		padding: 12vh 16px 16px;
	}
	.search-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.45);
	}
	.search-box {
		position: relative;
		width: 100%;
		max-width: 600px;
		background: var(--bg);
		padding: 16px;
		max-height: 70vh;
		display: flex;
		flex-direction: column;
	}
	.search-head { display: flex; align-items: center; gap: 10px; }
	.prompt {
		font-family: var(--font-silk);
		font-size: 0.65rem;
		color: var(--acc-d);
		flex-shrink: 0;
	}
	#search-input {
		flex: 1;
		font-family: var(--font-body);
		font-size: 1rem;
		background: var(--card);
		color: var(--ink);
		border: 3px solid var(--shadow);
		padding: 8px 12px;
		outline: none;
	}
	#search-input:focus { box-shadow: 3px 3px 0 var(--acc); }
	.search-close {
		font-family: var(--font-silk);
		font-size: 0.6rem;
		background: var(--card);
		color: var(--ink);
		cursor: pointer;
		padding: 6px 8px;
		flex-shrink: 0;
	}
	.search-close:hover { background: var(--pink); color: #fff; }

	.search-results {
		list-style: none;
		margin: 14px 0 0;
		padding: 0;
		overflow-y: auto;
	}
	.search-results li a {
		display: block;
		text-decoration: none;
		color: inherit;
		background: var(--card);
		border: 3px solid var(--shadow);
		padding: 10px 12px;
		margin-bottom: 10px;
		transition: transform 0.1s, box-shadow 0.1s;
	}
	.search-results li a:hover,
	.search-results li.active a {
		transform: translate(2px, 2px);
		box-shadow: 2px 2px 0 var(--acc);
	}
	.search-results .r-title { font-family: var(--font-pixel); font-size: 1.05rem; }
	.search-results li.active .r-title,
	.search-results li a:hover .r-title { color: var(--pink); }
	.search-results .r-desc {
		font-size: 0.85rem;
		color: var(--dim);
		margin: 4px 0 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.search-empty { color: var(--dim); margin: 16px 4px; }
	.search-hint { font-size: 0.72rem; color: var(--dim); margin: 12px 4px 0; }
	.search-hint kbd {
		font-family: var(--font-silk);
		font-size: 0.6rem;
		background: var(--card);
		border: 2px solid var(--shadow);
		padding: 1px 5px;
		margin: 0 1px;
	}

	@media (max-width: 520px) {
		.search-hint { display: none; }
	}
</style>

<script>
	import Fuse from 'fuse.js';

	const modal = document.getElementById('search-modal');
	const input = document.getElementById('search-input') as HTMLInputElement;
	const results = document.getElementById('search-results')!;
	const empty = document.getElementById('search-empty')!;
	const openBtn = document.getElementById('search-open');

	let fuse: Fuse<any> | null = null;
	let loaded = false;
	let active = -1;

	async function ensureIndex() {
		if (loaded) return;
		loaded = true;
		try {
			const res = await fetch('/search.json');
			const data = await res.json();
			fuse = new Fuse(data, {
				keys: [
					{ name: 'title', weight: 3 },
					{ name: 'tags', weight: 2 },
					{ name: 'description', weight: 2 },
					{ name: 'body', weight: 1 },
				],
				threshold: 0.4,
				ignoreLocation: true,
				minMatchCharLength: 1,
			});
		} catch (e) {
			loaded = false;
		}
	}

	function openModal() {
		ensureIndex();
		modal?.removeAttribute('hidden');
		document.body.style.overflow = 'hidden';
		setTimeout(() => input?.focus(), 0);
	}
	function closeModal() {
		modal?.setAttribute('hidden', '');
		document.body.style.overflow = '';
		input.value = '';
		results.innerHTML = '';
		empty.setAttribute('hidden', '');
		active = -1;
	}

	function render(items: any[]) {
		active = -1;
		if (!items.length) {
			results.innerHTML = '';
			empty.toggleAttribute('hidden', !input.value.trim());
			return;
		}
		empty.setAttribute('hidden', '');
		results.innerHTML = items
			.slice(0, 12)
			.map(
				(it) => `
			<li><a href="${it.url}">
				<div class="r-title"># ${it.title}</div>
				<p class="r-desc">${it.description ?? ''}</p>
			</a></li>`,
			)
			.join('');
	}

	function setActive(next: number) {
		const lis = Array.from(results.querySelectorAll('li'));
		if (!lis.length) return;
		active = (next + lis.length) % lis.length;
		lis.forEach((li, i) => li.classList.toggle('active', i === active));
		lis[active]?.scrollIntoView({ block: 'nearest' });
	}

	input?.addEventListener('input', () => {
		const q = input.value.trim();
		if (!q || !fuse) {
			render([]);
			return;
		}
		render(fuse.search(q).map((r) => r.item));
	});

	openBtn?.addEventListener('click', openModal);
	modal?.addEventListener('click', (e) => {
		if ((e.target as HTMLElement).hasAttribute('data-close')) closeModal();
	});

	document.addEventListener('keydown', (e) => {
		const open = !modal?.hasAttribute('hidden');
		const typing = ['INPUT', 'TEXTAREA'].includes((document.activeElement?.tagName ?? ''));
		if (e.key === '/' && !open && !typing) {
			e.preventDefault();
			openModal();
		} else if (e.key === 'Escape' && open) {
			closeModal();
		} else if (open && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) {
			e.preventDefault();
			setActive(active + (e.key === 'ArrowDown' ? 1 : -1));
		} else if (open && e.key === 'Enter') {
			const link = results.querySelectorAll('li')[active]?.querySelector('a') as HTMLAnchorElement;
			if (link) window.location.href = link.href;
		}
	});
</script>
