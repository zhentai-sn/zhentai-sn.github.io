---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Giscus from '../components/Giscus.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="zh">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main>
			<article>
				<a class="back" href="/blog">← 返回文章列表</a>

				<header class="post-head px">
					<span class="date">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="updated"> · 更新于 <FormattedDate date={updatedDate} /></span>
							)
						}
						<span class="views" id="busuanzi_container_page_pv">
							{' · 阅读 '}<span id="busuanzi_value_page_pv">…</span> 次
						</span>
					</span>
					<h1>{title}</h1>
					{description && <p class="desc">{description}</p>}
				</header>

				{
					heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</div>
					)
				}

				<div class="prose">
					<slot />
				</div>

				<Giscus />
			</article>
		</main>
		<Footer />

		<style>
			main { width: 760px; }
			.back {
				font-family: var(--font-pixel);
				font-size: 0.95rem;
				color: var(--acc-d);
				display: inline-block;
				margin-bottom: 1.4em;
			}
			.back:hover { color: var(--pink); }

			.post-head {
				background: var(--card);
				padding: 1.8em 2em;
				margin-bottom: 2em;
			}
			.date {
				font-family: var(--font-silk);
				font-size: 0.65rem;
				color: var(--acc-d);
				letter-spacing: 1px;
			}
			.updated { color: var(--dim); }
			.post-head h1 {
				font-size: 2.4rem;
				margin: 0.5em 0 0.3em;
			}
			.desc {
				color: var(--dim);
				font-size: 1.05rem;
				margin: 0;
			}

			.hero-image { margin-bottom: 2em; }
			.hero-image :global(img) {
				display: block;
				width: 100%;
			}

			.prose {
				color: var(--ink);
			}
			.prose :global(h2) { margin-top: 1.6em; }
			.prose :global(h3) { margin-top: 1.3em; }
		</style>
	</body>
</html>
